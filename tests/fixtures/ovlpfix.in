         o ! selection
  ovlpfix  ! filenames
         3 ! number of traits
    10.000 ! number of sires
   200.000 ! number of dams
     5.000 ! number of male offspring per dam
     5.000 ! number of female offspring per dam
         2 ! number of age classes per sex
         n ! method of selection
   500.000 ! number of animals in age-class   2
   500.000 ! number of animals in age-class   4
    10.000 ! number of selected animals in age-class   1
     0.000 ! number of selected animals in age-class   2
   120.000 ! number of selected animals in age-class   3
    80.000 ! number of selected animals in age-class   4
  wt       ! name of trait  1
         b ! use of wt      
     5.000 ! economic value wt      
  gr       ! name of trait  2
         h ! use of gr      
    -2.000 ! economic value gr      
  bf       ! name of trait  3
         i ! use of bf      
         y ! use of common environment
   100.000 ! phenotypic variance wt      
     0.300 ! heritability wt      
     0.050 ! common environmental effect wt      
    50.000 ! phenotypic variance gr      
     0.250 ! heritability gr      
     0.050 ! common environmental effect gr      
     4.000 ! phenotypic variance bf      
     0.400 ! heritability bf      
     0.050 ! common environmental effect bf      
         y ! full-sib groups ?
         1 ! number of fsgroups
     9.000 ! number of animals in fsgroup  1
         y ! half-sib groups ?
         1 ! number of hsgroups
   200.000 ! number of dams in hsgroup   1
     9.000 ! number of animals in hsgroup  1
         n ! progeny groups ?
         1 ! info source wt       for age class   1
         4 ! info source wt       for age class   1
        24 ! info source wt       for age class   1
        -1 ! info source wt       for age class   1
         1 ! info source bf       for age class   1
        -1 ! info source bf       for age class   1
         1 ! info source wt       for age class   3
         4 ! info source wt       for age class   3
        24 ! info source wt       for age class   3
        -1 ! info source wt       for age class   3
         1 ! info source bf       for age class   3
        -1 ! info source bf       for age class   3
         1 ! info source wt       for age class   4
         4 ! info source wt       for age class   4
        -1 ! info source wt       for age class   4
         1 ! info source bf       for age class   4
        -1 ! info source bf       for age class   4
     0.200 ! phenotypic correlation between wt       and gr      
     0.300 ! genetic correlation between wt       and gr      
     0.050 ! com.env. correlation between wt       and gr      
     0.100 ! phenotypic correlation between wt       and bf      
     0.200 ! genetic correlation between wt       and bf      
     0.050 ! com.env. correlation between wt       and bf      
     0.100 ! phenotypic correlation between gr       and bf      
     0.150 ! genetic correlation between gr       and bf      
     0.050 ! com.env. correlation between gr       and bf      
