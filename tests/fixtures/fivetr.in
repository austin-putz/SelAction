         1 ! stage selection
  fivetr   ! filenames
         5 ! number of traits
         n ! different indices for sires and dams
  eADG     ! name of trait  1
         i ! use of eADG    
  ADG      ! name of trait  2
         b ! use of ADG     
     5.000 ! economic value ADG     
  FCR      ! name of trait  3
         b ! use of FCR     
   -27.000 ! economic value FCR     
  BF       ! name of trait  4
         b ! use of BF      
    -2.000 ! economic value BF      
  LMP      ! name of trait  5
         h ! use of LMP     
     3.000 ! economic value LMP     
         y ! use of common environment
    25.000 ! phenotypic variance eADG    
     0.200 ! heritability eADG    
     0.050 ! common environmental effect eADG    
    95.000 ! phenotypic variance ADG     
     0.300 ! heritability ADG     
     0.050 ! common environmental effect ADG     
     0.040 ! phenotypic variance FCR     
     0.200 ! heritability FCR     
     0.050 ! common environmental effect FCR     
     4.000 ! phenotypic variance BF      
     0.400 ! heritability BF      
     0.050 ! common environmental effect BF      
     6.000 ! phenotypic variance LMP     
     0.350 ! heritability LMP     
     0.050 ! common environmental effect LMP     
         y ! full-sib groups ?
         1 ! number of fsgroups
     9.000 ! number of animals in fsgroup  1
         y ! half-sib groups ?
         1 ! number of hsgroups
   200.000 ! number of dams in hsgroup   1
     9.000 ! number of animals in hsgroup  1
         n ! progeny groups ?
         1 ! info source eADG    
         4 ! info source eADG    
        24 ! info source eADG    
        -1 ! info source eADG    
         1 ! info source ADG     
         4 ! info source ADG     
        24 ! info source ADG     
        -1 ! info source ADG     
         1 ! info source FCR     
         4 ! info source FCR     
        24 ! info source FCR     
        -1 ! info source FCR     
         1 ! info source BF      
         4 ! info source BF      
        24 ! info source BF      
        -1 ! info source BF      
     0.250 ! phenotypic correlation between eADG     and ADG     
     0.250 !    genetic correlation between eADG     and ADG     
     0.050 !   com.env. correlation between eADG     and ADG     
     0.100 ! phenotypic correlation between eADG     and FCR     
     0.100 !    genetic correlation between eADG     and FCR     
     0.050 !   com.env. correlation between eADG     and FCR     
     0.100 ! phenotypic correlation between eADG     and BF      
     0.100 !    genetic correlation between eADG     and BF      
     0.050 !   com.env. correlation between eADG     and BF      
     0.050 ! phenotypic correlation between eADG     and LMP     
     0.050 !    genetic correlation between eADG     and LMP     
     0.050 !   com.env. correlation between eADG     and LMP     
    -0.500 ! phenotypic correlation between ADG      and FCR     
    -0.500 !    genetic correlation between ADG      and FCR     
     0.050 !   com.env. correlation between ADG      and FCR     
     0.200 ! phenotypic correlation between ADG      and BF      
     0.200 !    genetic correlation between ADG      and BF      
     0.050 !   com.env. correlation between ADG      and BF      
     0.100 ! phenotypic correlation between ADG      and LMP     
     0.100 !    genetic correlation between ADG      and LMP     
     0.050 !   com.env. correlation between ADG      and LMP     
     0.150 ! phenotypic correlation between FCR      and BF      
     0.200 !    genetic correlation between FCR      and BF      
     0.050 !   com.env. correlation between FCR      and BF      
    -0.100 ! phenotypic correlation between FCR      and LMP     
    -0.150 !    genetic correlation between FCR      and LMP     
     0.050 !   com.env. correlation between FCR      and LMP     
    -0.300 ! phenotypic correlation between BF       and LMP     
    -0.400 !    genetic correlation between BF       and LMP     
     0.050 !   com.env. correlation between BF       and LMP     
    10.000 ! number of sires
   200.000 ! number of dams
     5.000 ! male candidates per dam
     5.000 ! female candidates per dam
     0.010 ! proportion sires
     0.200 ! proportion dams
