         o ! selection
  ovlpwarn ! filenames
         3 ! number of traits
    10.000 ! number of sires
   200.000 ! number of dams
     5.000 ! number of male offspring per dam
     1.000 ! number of female offspring per dam
         3 ! number of age classes per sex
         t ! method of selection
   300.000 ! number of animals in age-class   2
   200.000 ! number of animals in age-class   3
    30.000 ! number of animals in age-class   5
    20.000 ! number of animals in age-class   6
  wt       ! name of trait  1
         b ! use of wt      
     5.000 ! economic value wt      
  gr       ! name of trait  2
         b ! use of gr      
    -2.000 ! economic value gr      
  ebv      ! name of trait  3
         i ! use of ebv     
         n ! use of common environment
   100.000 ! phenotypic variance wt      
     0.300 ! heritability wt      
    50.000 ! phenotypic variance gr      
     0.250 ! heritability gr      
    10.000 ! phenotypic variance ebv     
     0.300 ! heritability ebv     
         n ! full-sib groups ?
         n ! half-sib groups ?
         n ! progeny groups ?
         1 ! info source wt       for age class   1
        -1 ! info source wt       for age class   1
         1 ! info source gr       for age class   1
        -1 ! info source gr       for age class   1
         2 ! info source ebv      for age class   1
        -1 ! info source ebv      for age class   1
        -1 ! next age-class 
         1 ! info source wt       for age class   4
        -1 ! info source wt       for age class   4
         1 ! info source gr       for age class   4
        -1 ! info source gr       for age class   4
         2 ! info source ebv      for age class   4
        -1 ! info source ebv      for age class   4
         6 ! next age-class 
         1 ! info source wt       for age class   6
        -1 ! info source wt       for age class   6
         1 ! info source gr       for age class   6
        -1 ! info source gr       for age class   6
         2 ! info source ebv      for age class   6
        -1 ! info source ebv      for age class   6
        -1 ! next age-class 
     0.200 ! phenotypic correlation between wt       and gr      
     0.300 ! genetic correlation between wt       and gr      
     0.100 ! phenotypic correlation between wt       and ebv     
     0.000 ! genetic correlation between wt       and ebv     
     0.100 ! phenotypic correlation between gr       and ebv     
     0.000 ! genetic correlation between gr       and ebv     
